# このファイルを .env にコピーして値を埋めてください。
# .env は .gitignore 済み (コミットされません)。

# Redash のベース URL (末尾スラッシュ不要)
REDASH_URL=https://redash.example.com

# Redash の API キー
#   取得: Redash 右上アバター → Edit Profile → API Key (個人キー)
#   ※ クエリ個別のキーではなくユーザー API キーを使うこと
REDASH_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 任意 ---
# クエリ完了待ちの最大秒数 (既定 120)
# REDASH_TIMEOUT=120
# 1 回の結果で返す既定の最大行数 (既定 1000)
# REDASH_MAX_ROWS=1000
# SELECT 以外の SQL も許可する場合のみ 1 (既定: 読み取り専用のみ)
# REDASH_ALLOW_WRITE=0
